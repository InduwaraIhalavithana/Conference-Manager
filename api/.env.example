# Copy to api/.env (git-ignored) and fill in the two secrets. Other defaults match docker-compose.dev.yml.

# Required: a random string of at least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The admin account is created on first start from these two. Choose your own password (10+ characters);
# it is never logged and only stored as an Argon2 hash.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

ENVIRONMENT=development
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=conferencehub
REDIS_URL=redis://127.0.0.1:6379/0
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=["http://localhost:3100"]
# true behind HTTPS (required when ENVIRONMENT=production)
COOKIE_SECURE=false
LOG_FORMAT=console

# Email: "queue" needs the worker running (uv run arq app.worker.WorkerSettings); "log" needs nothing.
EMAIL_DELIVERY=queue
# Gmail address and app password for sending. Leave empty to only log emails (codes appear in the worker log).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional error tracking
SENTRY_DSN=
