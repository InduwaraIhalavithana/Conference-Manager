DATABASE_URL=postgresql://postgres:password@localhost:5432/conference_db
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# The administrator account created on first start (sign in with this email).
ADMIN_EMAIL=admin.conferencehub@gmail.com
ADMIN_INITIAL_PASSWORD=choose-a-strong-password

# Links in emails point here.
FRONTEND_URL=http://localhost:5174

# Gmail SMTP. Leave both empty to disable sending; emails (and verification links) are then written to the
# server log. The password is a Google "app password" (needs 2-Step Verification on the account), not the
# normal Gmail password. Test it with: python -m scripts.send_test_email you@example.com
GMAIL_USER=admin.conferencehub@gmail.com
GMAIL_APP_PASSWORD=

# Optional
# UPLOAD_DIR=uploads
# REMINDER_INTERVAL_SECONDS=900
# CONFIRM_HOLD_HOURS=24    how long an unconfirmed registration holds its seat
# VERIFY_LINK_HOURS=48     how long an organizer's sign-up verification link works
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
