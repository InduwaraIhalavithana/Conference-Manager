{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/en",
        "http://localhost:3100/en/conferences",
        "http://localhost:3100/en/c/spike-colombo-tech-summit",
        "http://localhost:3100/si/about",
        "http://localhost:3100/ta/contact"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
